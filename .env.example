# ==============================================================================
# ASTRA AI — Complete Environment Configuration Template
# ==============================================================================
# Copy this file to .env to configure your local environment:
#   copy .env.example .env
#
# PRIMARY AI ARCHITECTURE:
# Google Gemini is configured as ASTRA AI's primary general-purpose intelligence engine.
#
# Supported Providers:
# 1. Google Gemini (Default Primary — fast, state-of-the-art, generous free tier)
# 2. Local Ollama (Optional offline fallback — zero-cost, runs private on your machine)
# 3. OpenAI (GPT-4o-mini)
# 4. Built-in ASTRA Core (Zero-dependency offline rule & knowledge engine)
# ==============================================================================

# Backend for Frontend (BFF) Configuration
CLIENT_BACKEND_PORT=3001
CLIENT_BACKEND_HOST=127.0.0.1

# Python MCP Server Configuration (Official MCP SDK Streamable HTTP)
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Database Persistence Path (SQLite)
ASTRA_DB_PATH=data/astra.db

# Timezone Configuration
DEFAULT_TIMEZONE=Asia/Kolkata

# ==============================================================================
# AI Provider Configuration
# ==============================================================================
# AI_PROVIDER options:
#   • 'gemini'  : (Default Primary) Google Gemini intelligence engine.
#                 Requires GEMINI_API_KEY below.
#   • 'auto'    : Prioritizes Gemini when configured, falls back to Ollama or Builtin Core.
#   • 'ollama'  : Explicitly forces local Ollama running on your machine.
#   • 'openai'  : Uses OpenAI API (requires OPENAI_API_KEY).
#   • 'builtin' : Offline rule-based conversational & tools engine (no external network).
AI_PROVIDER=gemini

# ------------------------------------------------------------------------------
# Primary Provider: Google Gemini (Official Google Gen AI SDK)
# ------------------------------------------------------------------------------
# 1. Get your free API key at: https://aistudio.google.com/app/apikey
# 2. Paste it below (keep it secret; never commit your real key):
# GEMINI_API_KEY=AIzaSy...

# Default supported model (gemini-3.1-flash-lite, gemini-flash-lite-latest, or gemini-3.5-flash):
GEMINI_MODEL=gemini-3.1-flash-lite

# ------------------------------------------------------------------------------
# Optional Local Fallback Provider: Ollama (Offline Mode)
# ------------------------------------------------------------------------------
# Used when AI_PROVIDER=ollama or as an offline fallback when GEMINI_API_KEY is not set.
# 1. Download & install Ollama: https://ollama.com
# 2. Pull model: ollama run qwen3:0.6b (or gemma2:2b / qwen3:4b)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b

# ------------------------------------------------------------------------------
# Optional Cloud Provider: OpenAI
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
